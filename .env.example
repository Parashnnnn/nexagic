# ==============================================================================
# NexAgic Environment Configuration
# ==============================================================================

# --- LLM Provider (Anthropic Claude) ---
# Your Anthropic API key (from https://console.anthropic.com/)
# If left blank, NexAgic will run in autonomous live search fallback mode
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model to use for native tool use reasoning & final report synthesis
# Examples: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229
NEXAGIC_MODEL=claude-3-5-sonnet-20241022

# --- Search Engine Provider ---
# Provider options: "tavily" (recommended for deep web intelligence) or "ddg" (DuckDuckGo keyless)
SEARCH_PROVIDER=tavily

# Tavily API Key (from https://tavily.com/)
# If not provided, NexAgic automatically falls back to DuckDuckGo live search
TAVILY_API_KEY=tvly-...

# --- Agent ReAct Loop Parameters ---
# Maximum autonomous search/fetch steps in Quick mode (default: 8)
MAX_AGENT_STEPS=8

# Maximum autonomous search/fetch steps in Deep Research mode (default: 15)
MAX_AGENT_STEPS_DEEP=15

# --- Security, SSRF & Fetch Limits ---
# Timeout in seconds when fetching external web pages
FETCH_TIMEOUT_SECONDS=12.0

# Maximum page download size in bytes before streaming cut-off (2MB default)
FETCH_MAX_BYTES=2000000

# Maximum extracted characters returned to the model per page to prevent context overflow
MAX_PAGE_CONTENT_CHARS=16000

# Cache TTL in seconds for search results and fetched pages
CACHE_TTL_SECONDS=3600

# --- Database & Storage ---
# SQLite async database URI (can be pointed to postgresql+asyncpg://... for production)
DATABASE_URL=sqlite+aiosqlite:///./nexagic.db

# --- API Server & Networking ---
# Allowed CORS origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# IP sliding-window rate limit for /api/chat/stream (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Optional authentication flag (disabled by default)
AUTH_ENABLED=false

# --- Frontend Settings ---
# URL pointing to the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
